{
  "name": "pressrecall",
  "version": "0.1.0",
  "private": true,
  "description": "Revision-aware print recall, scoped purchasing and site acceptance.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "predev": "npm run build",
    "dev": "node dist/src/main.js",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec \"dist/tests/*.test.js\"",
    "prestart": "npm run build",
    "test:browser": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "playwright": "^1.65.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@altananetwork/sdk": "1.1.0",
    "viem": "2.57.18"
  }
}
